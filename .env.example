# Pinarr - Configuration
# Copiez ce fichier vers .env et adaptez les valeurs
#   cp .env.example .env

# ===========================================
# OBLIGATOIRE : Changez le mot de passe admin
# ===========================================
ADMIN_PASSWORD=changez-moi

# ===========================================
# OPTIONNEL : Configuration des ports
# ===========================================
# Port de l'interface web (défaut: 8908)
# PORT=8908

# Port API direct - compatibilité anciennes versions (défaut: 9994)
# BACKEND_PORT=9994

# ===========================================
# OPTIONNEL : Compte admin
# ===========================================
# Nom d'utilisateur admin (défaut: admin)
# ADMIN_USERNAME=admin

# ===========================================
# OPTIONNEL : Sécurité
# ===========================================
# Clé secrète JWT - laissez vide pour génération auto persistée
# (stockée dans ./data/secret_key, survit aux redémarrages)
# SECRET_KEY=

# ===========================================
# NOTES
# ===========================================
# - Les données sont conservées dans les dossiers ./data et ./uploads
# - .env est ignoré par git : ne le committez jamais